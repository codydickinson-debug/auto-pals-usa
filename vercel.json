    { "source": "/api/email",   "destination": "/api/email.js" },
    { "source": "/api/sms",     "destination": "/api/sms.js" },
    { "source": "/api/ai",      "destination": "/api/ai.js" },
    { "source": "/api/booking", "destination": "/api/booking.js" },
    { "source": "/api/cron",    "destination": "/api/cron.js" },
    { "source": "/api/portal-recover", "destination": "/api/portal-recover.js" },
    { "source": "/api/portal-sign",    "destination": "/api/portal-sign.js" },
    { "source": "/api/portal-login",   "destination": "/api/portal-login.js" },
    { "source": "/api/quote-response", "destination": "/api/quote-response.js" },
    { "source": "/api/create-checkout","destination": "/api/create-checkout.js" },
    { "source": "/home",     "destination": "/home.html" },
    { "source": "/form",     "destination": "/form.html" },
    { "source": "/request",  "destination": "/request.html" },
    { "source": "/portal",   "destination": "/portal.html" },
    { "source": "/booking",  "destination": "/booking.html" },
    { "source": "/mechanic-shop", "destination": "/mechanic-shop.html" },
