{
  "rewrites": [
    { "source": "/api/db",      "destination": "/api/db.js" },
    { "source": "/api/auth",    "destination": "/api/auth.js" },
    { "source": "/api/email",   "destination": "/api/email.js" },
    { "source": "/api/sms",     "destination": "/api/sms.js" },
    { "source": "/api/ai",      "destination": "/api/ai.js" },
    { "source": "/api/booking", "destination": "/api/booking.js" },
    { "source": "/api/cron",    "destination": "/api/cron.js" },
    { "source": "/api/portal-recover", "destination": "/api/portal-recover.js" },
    { "source": "/api/portal-sign",    "destination": "/api/portal-sign.js" },
    { "source": "/api/portal-login",   "destination": "/api/portal-login.js" },
    { "source": "/api/quote-response", "destination": "/api/quote-response.js" },
    { "source": "/api/create-checkout","destination": "/api/create-checkout.js" },
    { "source": "/api/quo-webhook",   "destination": "/api/quo-webhook.js" },
    { "source": "/api/quo-sync",      "destination": "/api/quo-sync.js" },
    { "source": "/home",     "destination": "/home.html" },
    { "source": "/form",     "destination": "/form.html" },
    { "source": "/request",  "destination": "/request.html" },
    { "source": "/portal",   "destination": "/portal.html" },
    { "source": "/booking",  "destination": "/booking.html" },
    { "source": "/mechanic-shop", "destination": "/mechanic-shop.html" },
    { "source": "/deposit",  "destination": "/deposit.html" },
    { "source": "/deposit-complete", "destination": "/deposit-complete.html" },
    { "source": "/privacy",  "destination": "/privacy.html" },
    { "source": "/terms",    "destination": "/terms.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Content-Security-Policy", "value": "frame-ancestors 'self'" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "geolocation=(), microphone=(), camera=(self)" }
      ]
    },
    {
      "//": "Always-revalidate the HTML pages so a normal load picks up the newest deploy — no more hard-refresh (Cmd+Shift+R). The big inlined assets still cache; the browser just checks with the server first and gets a fast 304 when nothing changed.",
      "source": "/(.*\\.html)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/(home|form|request|portal|booking|mechanic-shop|deposit|deposit-complete|privacy|terms)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    }
  ],
  "functions": {
    "api/sms-consent-sync.js": { "maxDuration": 60 },
    "api/quo-sync.js": { "maxDuration": 60 },
    "api/cron.js": { "maxDuration": 300 }
  },
  "crons": [
    {
      "path": "/api/cron",
      "schedule": "0 14 * * *"
    }
  ]
}
